generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum ArtworkType {
  painting
  sculpture
  photography
  drawing
  print
}

model Artwork {
  id           String      @id @default(uuid()) @db.Uuid
  title        String      @db.VarChar(99)
  artist       String      @db.VarChar(50)
  type         ArtworkType
  /// DB also enforces price > 0 via CHECK "Artwork_price_positive" (migration artwork_price_positive).
  price        Decimal     @db.Decimal(12, 2)
  availability Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}
